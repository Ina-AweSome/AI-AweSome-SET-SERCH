}, "手形法7条": {"t": "手形行為独立の原則。手形上の署名のうち一部が無効でも、他の署名者の債務は影響を受けない。", "w": "", "src": "Claude／2026-09-06商法 Q313"}, "手形法8条": {"t": "代理権なく他人の代理人として手形に署名した者は、自ら手形上の義務を負う。", "w": "", "src": "Claude／2026-09-06商法 Q325"}, "最判昭31.2.7": {"t": "連続の欠けている部分について実質的な権利移転の事実を立証すれば、手形上の権利を行使できる。", "w": "", "src": "Gemini／2026-08-30商法 Q309"}, "最判昭33.3.20": {"t": "手形行為独立の原則により、実質的な権利を有しない盗取者であっても、自ら裏書人として手形に署名した以上、手形上の遡求責任を負う。", "w": "", "src": "Gemini／2026-09-06商法 Q313"}, "最判昭42.4.25": {"t": "手形上の権利は実質的に裏書人に留まるため、手形債務者は裏書人に対する抗弁をもって被裏書人に対抗することができる。", "w": "", "src": "Gemini／2026-09-06商法 Q320"}, "最判昭44.3.27": {"t": "持分移転登記をしなければ第三者に対抗できない。", "w": "", "src": "Gemini／2026-09-22民法 Q142"}, "民法193条": {"t": "窃盗による取得物", "w": "", "src": "自分のノート"}, "民法651条": {"t": "「いつでも」解除できる点：理由の如何を問わず、各当事者が一方的に解除可能。契約違反がなくても解除できる。", "w": "", "src": "自分のノート"}, "破産法62条": {"t": "破産者に属しない財産を、破産財団から取り戻す権利は、破産手続の開始によって妨げられないと定めます。", "w": "", "src": "ChatGPT／2026-09-06商法 Q320"}}}
